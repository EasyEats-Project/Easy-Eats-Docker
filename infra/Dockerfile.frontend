# syntax=docker/dockerfile:1
# Contexto principal: ../frontend (clone). O contexto nomeado "infra" (infra/) é
# declarado em additional_contexts no docker-compose.yml e fornece o nginx.conf.

# Estágio de compilação do Angular
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build -- --configuration production

# Estágio de servidor com Nginx
FROM nginx:alpine
COPY --from=infra nginx.conf /etc/nginx/conf.d/default.conf
# angular.json não define outputPath: o padrão do builder application é dist/<projeto>/browser
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html
EXPOSE 80
