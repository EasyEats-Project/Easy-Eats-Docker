# Copie este arquivo para infra/.env e ajuste os valores.
# Nunca versione o .env com valores reais.

# --- PostgreSQL ---
# POSTGRES_* só têm efeito na criação inicial do DB_Volume.
# Alterá-las depois NÃO muda as credenciais de um banco já inicializado
# (veja ../README.md para trocar a senha com ALTER USER).
POSTGRES_DB=easy_eats
POSTGRES_USER=easyeats
POSTGRES_PASSWORD=troque-esta-senha

# --- Backend ---
# DB_URL, DB_USER e DB_PASSWORD NÃO são definidas aqui:
# o docker-compose.yml as deriva de POSTGRES_*.
# JWT_SECRET: segredo em Base64. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-em-base64

# --- CORS (OBRIGATÓRIA; lista separada por vírgula, sem espaços) ---
# Inclua a origem da LAN se acessar o frontend por outro dispositivo,
# ex.: http://localhost:4200,http://192.168.0.10:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Portas publicadas no host ---
FRONTEND_PORT=4200
BACKEND_PORT=8080
